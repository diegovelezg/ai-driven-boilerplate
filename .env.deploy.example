# Deploy en Coolify — variables del compose raíz (TODO JUNTO).
# 1. Genera secretos (una vez):
#      openssl rand -hex 32   # -> JWT_SECRET
#      openssl rand -hex 32   # -> PG_META_CRYPTO_KEY
#      openssl rand -base64 32 # -> SECRETS_ENCRYPTION_KEY
#      openssl rand -hex 32   # -> SEARXNG_SECRET_KEY
#      openssl rand -hex 32   # -> POSTGRES_PASSWORD
# 2. Deriva las API keys desde JWT_SECRET:
#      python3 infra/supabase/gen-keys.py '<JWT_SECRET>'
#    Pega la salida en ANON_KEY / SERVICE_ROLE_KEY.
# 3. Pega todo esto en Coolify (Service -> Environment).

# --- Postgres / JWT (base de todo) ---
POSTGRES_PASSWORD=""
POSTGRES_DB="postgres"
JWT_SECRET=""
JWT_EXPIRY="3600"
ANON_KEY=""
SERVICE_ROLE_KEY=""
PG_META_CRYPTO_KEY=""

# --- URLs públicas (3 dominios asignados en Coolify) ---
SITE_URL="https://app.tudominio.com"
API_EXTERNAL_URL="https://api.tudominio.com"
SUPABASE_PUBLIC_URL="https://api.tudominio.com"
ADDITIONAL_REDIRECT_URLS="https://app.tudominio.com/**"
DISABLE_SIGNUP="false"
ENABLE_EMAIL_AUTOCONFIRM="true"

# --- Studio ---
STUDIO_DEFAULT_ORGANIZATION="retain"
STUDIO_DEFAULT_PROJECT="retain-engine-ai"

# --- Web ---
SECRETS_ENCRYPTION_KEY=""
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# --- SearXNG ---
SEARXNG_SECRET_KEY=""
SEARXNG_BASE_URL="http://searxng:8080/"
