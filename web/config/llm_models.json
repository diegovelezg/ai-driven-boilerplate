{
    "$comment": "Configuración LLM — MEOW. Primario gpt-6-luna (OpenAI) + fallback deepseek-flash. Escala 'reasoning_effort': low|medium|high|max|none. Verificado 2026-10-16 con sondas: luna en chat/completions exige max_completion_tokens (no max_tokens), solo temperature=1 (se omite), effort high OK, json_object OK, tools OK solo con effort 'none' (por eso customer_chat usa none). deepseek-v4-flash NO existe: fallback es deepseek-flash (tools + thinking verificados). json_mode: native=response_format json_object, none=texto libre.",
  "providers": {
    "deepseek": {
      "api_key_env": "DEEPSEEK_API_KEY",
      "base_url": "https://api.deepseek.com",
      "backend": "openai"
    },
    "openai": {
      "api_key_env": "OPENAI_API_KEY",
      "base_url": "https://api.openai.com/v1",
      "backend": "openai"
    },
    "anthropic": {
      "api_key_env": "ANTHROPIC_API_KEY",
      "base_url": "https://api.anthropic.com",
      "backend": "anthropic"
    },
    "gemini": {
      "api_key_env": "GEMINI_API_KEY",
      "backend": "google.genai"
    }
  },
  "processes": {
    "customer_chat": {
      "primary": { "provider": "openai", "model": "gpt-6-luna", "quality": "media" },
      "fallback": { "provider": "deepseek", "model": "deepseek-flash", "quality": "media" },
      "temperature": 0.4,
      "max_tokens": 1500,
      "reasoning_effort": "none",
      "json_mode": "none"
    },
    "customer_classify": {
      "primary": { "provider": "openai", "model": "gpt-6-luna", "quality": "media" },
      "fallback": { "provider": "deepseek", "model": "deepseek-flash", "quality": "media" },
      "temperature": 0.2,
      "max_tokens": 2500,
      "reasoning_effort": "high",
      "json_mode": "native"
    },
    "enrichment": {
      "primary": { "provider": "openai", "model": "gpt-6-luna", "quality": "economica" },
      "fallback": { "provider": "deepseek", "model": "deepseek-flash", "quality": "economica" },
      "temperature": 0.1,
      "max_tokens": 500,
      "reasoning_effort": "low",
      "json_mode": "native"
    },
    "retrieval_queries": {
      "primary": { "provider": "openai", "model": "gpt-6-luna", "quality": "media" },
      "fallback": { "provider": "deepseek", "model": "deepseek-flash", "quality": "media" },
      "temperature": 0.3,
      "max_tokens": 2500,
      "reasoning_effort": "high",
      "json_mode": "native"
    },
    "profiler_synthesize": {
