# Supabase (obligatorio). Local: ver keys con `npx supabase status`.
# En prod: VALOR LITERAL, nunca ${...} entre recursos
# (no resuelve y el worker queda sin key: 401 No API key):
#   SUPABASE_URL = https://<tu-api-publica> (HTTPS pública,
#     no localhost ni hostname interno)
#   SUPABASE_SERVICE_ROLE_KEY = SERVICE_ROLE_KEY legacy o SUPABASE_SECRET_KEY
#     (sb_secret_...). NO usar SERVICE_ROLE_KEY_ASYMMETRIC (JWK, no es apikey).
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""
# Duplicadas con prefijo público: el browser solo ve NEXT_PUBLIC_* (login/avatar).
# Mismo valor que las de arriba; la anon key es pública por diseño (RLS protege).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# Secrets de Settings en DB cifrada (issue #20, AES-256-GCM app-level).
# 32 bytes en base64. Generar con: openssl rand -base64 32
# Sin esta key, las API keys caen al JSON local (.data/connections.json, solo dev).
SECRETS_ENCRYPTION_KEY=""

# LLM para el chat "Preguntar" de customers (ver config/llm_models.json).
# El agente ADK usa el backend según el provider del proceso; define la key del
# proveedor que uses (primario y/o fallback).
#   openai    → OpenAI estándar u otro endpoint /chat/completions (DeepSeek, Groq…)
#   anthropic → Claude (Messages API)
#   google.genai → Gemini
DEEPSEEK_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GEMINI_API_KEY=""

# SearXNG (enriquecimiento/prospección, web/lib/retrieval.ts).
# URL HTTPS pública de la instancia SearXNG, sin / final.
SEARXNG_URL=""
# Si el SearXNG es compartido y protegido con Basic Auth (Traefik):
# "usuario:clave" en claro (el código la codifica a Base64 por llamada).
# Sin esto, contra una instancia protegida todo da 401.
SEARXNG_BASIC_AUTH=""

# Worker (Fase 2: no-op, sin cron programado):
#   0 11 * * * / npm run worker -- --once --kinds=morning / timeout 3600
# Daemon interno solo dev/local (default apagado):
#   WORKER_SCHEDULE=1 + WORKER_CRON_HOUR/WORKER_CRON_MINUTE (default 6:00 Lima).
# WORKER_SCHEDULE=""
# WORKER_CRON_HOUR=""
# WORKER_CRON_MINUTE=""

# Mapbox (mini-mapa drawer pantallas + enriquecimiento server por pantalla)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
# Token server para el enriquecimiento geo (si se omite, se reutiliza el NEXT_PUBLIC_*).
# MAPBOX_ACCESS_TOKEN=""
