#!/usr/bin/env bash
# pre-push: si el push lleva migraciones nuevas, aplicarlas al VPS primero.
# La DB migra antes que el código; si falla, el push se bloquea.
# Setup (una vez por clon): ./scripts/install-hooks.sh
# Requiere lo mismo que el modo manual: DB_CONTAINER y VPS_IP en el env.
set -euo pipefail

MIGRATIONS="supabase/migrations"
ZERO="0000000000000000000000000000000000000000"
has_migrations=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue # borrando rama: nada que migrar
  if [ "$remote_sha" = "$ZERO" ]; then
    range="$local_sha"
  else
    range="$remote_sha...$local_sha"
  fi
  if git diff --name-only "$range" -- "$MIGRATIONS" | grep -q .; then
    has_migrations=1
    break
  fi
done

[ "$has_migrations" = "0" ] && exit 0

echo "pre-push: el push incluye migraciones → aplicando al VPS antes..."
: "${DB_CONTAINER:?pre-push bloqueado: exporta DB_CONTAINER (supabase-db-<uuid>)}"
: "${VPS_IP:?pre-push bloqueado: exporta VPS_IP}"
export DB_CONTAINER VPS_IP SSHPASS="${SSHPASS:-}"
exec "$(dirname "$0")/../retain-apply.sh" schema
